# AnythingLLM Configuration
# These values are used by the backend proxy - never expose API keys in the frontend

# AnythingLLM API Base URL
ANYTHINGLLM_URL=http://localhost:3001/api/v1

# Workspace IDs (set by AnythingLLM when creating workspaces)
WORKSPACE_ID_SUPORTE=workspace-id-suporte
WORKSPACE_ID_FINANCEIRO=workspace-id-financeiro
WORKSPACE_ID_IMPLANTAÇAO=workspace-id-implantacao
WORKSPACE_ID_GLOSSARIO=workspace-id-glossario

# Frontend
NG_PORT=4200
IIS_HOST=192.168.2.130
IIS_PORT=1010